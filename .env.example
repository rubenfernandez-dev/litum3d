# Server
PORT=3000
NODE_ENV=development
# BASE_URL: URL pública canónica de esta app. Ya se usaba para generar
# enlaces en emails/SEO (routes/payments.js, config/seo.js, routes/seo.js);
# desde P0-SECURITY-01 (cierre final) también es la AUTORIDAD del origin
# esperado para la protección same-origin de POST /admin/login
# (middleware/sameOrigin.js): la petición debe demostrar que viene
# EXACTAMENTE de new URL(BASE_URL).origin (scheme+host+puerto), vía el header
# Origin (o Referer como fallback). No es secreto.
# OBLIGATORIO en producción: si falta o no es una URL absoluta válida, el
# servidor rechaza arrancar (fail-closed) -- sin esto ninguna petición de
# login, ni siquiera la legítima, podría demostrar same-origin nunca. En
# desarrollo/tests no hace falta configurarlo explícitamente: si falta, se
# usa http://localhost:<PORT> automáticamente.
BASE_URL=http://localhost:3000
# PUBLIC_BASE_URL (opcional): sobreescribe BASE_URL si el dominio público
# real difiere del valor interno de BASE_URL (mismo uso que en
# routes/payments.js). Si se define, tiene prioridad sobre BASE_URL también
# para el origin esperado de same-origin.
# PUBLIC_BASE_URL=https://litum3d.com

# Session
# OBLIGATORIO: sin este valor el servidor rechaza arrancar (fail-closed,
# P0-SECURITY-01). Genera uno fuerte y distinto para cada entorno, p.ej.:
#   openssl rand -base64 32
# NUNCA reutilizar este valor como UPLOAD_PREVIEW_SECRET/STRIPE_WEBHOOK_SECRET
# (ni al revés) -- cada secreto tiene su propia función.
SESSION_SECRET=replace_with_a_strong_random_secret

# Trust proxy (opcional). Por defecto: 1 hop en producción (Nginx delante,
# ver DEPLOYMENT-GUIDE.md), desactivado en desarrollo. Solo cambiar si la
# topología de despliegue real es distinta (más hops, o sin proxy).
# TRUST_PROXY=1

# Fotos de personalización (P0-FOTOS-01): secreto DEDICADO para firmar los
# capability tokens de preview privado (GET /api/uploads/custom/preview/...).
# NUNCA reutilizar SESSION_SECRET aquí -- deben ser secretos independientes.
# Sin este valor, el upload/preview de fotos falla de forma segura (ningún
# token se emite ni se acepta). Debe ser estable entre reinicios/despliegues.
UPLOAD_PREVIEW_SECRET=replace_with_a_strong_random_secret

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=litum3d

# Stripe
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
# Webhook (P0E-B5): whsec_... entregado por `stripe listen` en local, o por
# el endpoint configurado en el Dashboard de Stripe en producción. Sin este
# valor, POST /api/stripe/webhook rechaza todos los eventos (fail-closed).
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email Configuration
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
ADMIN_EMAIL=admin@example.com
CONTACT_TO=contact@example.com
# Cloudinary (REQUERIDO para subir imágenes en reseñas)
# Obtén tus credenciales de: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=litum3d